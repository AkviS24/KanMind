# Django settings
# Generate a unique key with:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-this-with-a-generated-secret-key
DEBUG=False
ALLOWED_HOSTS=ak-coding.de,www.ak-coding.de
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=https://ak-coding.de,https://www.ak-coding.de
SECURE_SSL_REDIRECT=True

# Keep HSTS disabled until HTTPS has been verified in production.
SECURE_HSTS_SECONDS=0

# Persistent paths on the T-95 Toshiba storage
KANMIND_DATA_DIR=/srv/storage/webhosting/projects/KanMind/data
KANMIND_STATIC_DIR=/srv/storage/webhosting/projects/KanMind/staticfiles

# Separate KanMind demo backend and database
KANMIND_DEMO_SECRET_KEY=replace-this-with-a-second-generated-secret-key
KANMIND_GUEST_EMAIL=replace-with-the-email-from-the-frontend-guest-login
KANMIND_GUEST_PASSWORD=replace-with-the-password-from-the-frontend-guest-login
KANMIND_GUEST_FULLNAME=KanMind Guest
KANMIND_DEMO_DATA_DIR=/srv/storage/webhosting/projects/KanMind/demo-data
KANMIND_DEMO_STATIC_DIR=/srv/storage/webhosting/projects/KanMind/demo-staticfiles
